# Copy this file to .env and edit. NEVER commit .env to GitHub.
# Local quick start (no PostgreSQL needed):
DATABASE_URL=sqlite:///./isoko.db
# PostgreSQL (docker compose or a hosted database):
# DATABASE_URL=postgresql+psycopg2://isoko:isoko@localhost:5432/isoko

APP_ENV=development
# Generate a strong value: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_MINUTES=480

# First administrator, created by "python -m app.seed"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123

# Review thresholds
PRICE_CHANGE_THRESHOLD_PCT=25
CPI_MOM_THRESHOLD_PCT=5
